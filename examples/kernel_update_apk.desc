# This could be used for any APK
# A few notes:
# - --no-network forces disabling internet access, apk commands
# can be used with internet enabled with swdesc_command instead
# - for linux, we remove any manually installed kernel (either
# package or file) before installing apk to ensure apk add does
# something; if apk was already installed just removing file would
# success and leave the system without kernel modules

swdesc_option component=extra_os.kernel
swdesc_option version=5.10.82-1

swdesc_exec "linux-at-5.10.9-r3.apk" \
	"apk del --no-network --force-broken-world 'linux-at-*'" \
	'rm -rf /lib/modules' \
	'apk add --no-network --force-broken-world $1'

# it's also possible to have a whole update via internet
#swdesc_command "apk add linux-at"


# add the kernel to files to be preserved on OS update
swdesc_script "$SCRIPT_DIR/examples/update_preserve_files.sh" -- \
	"POST /boot" \
	"POST /lib/modules"
